{
  "name": "ragre",
  "version": "1.0.0",
  "description": "Benchmarking tool for RAG retrieval quality on SciFact",
  "license": "ISC",
  "author": "PrithviDRajvanshi",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/scripts/check-db.ts",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx src/scripts/check-db.ts",
    "data:download": "tsx src/scripts/download-scifact.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "data:import": "tsx src/scripts/import-scifact.ts",
    "embed": "tsx src/scripts/embed-documents.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "dotenv": "^18.0.8",
    "fflate": "^0.8.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
